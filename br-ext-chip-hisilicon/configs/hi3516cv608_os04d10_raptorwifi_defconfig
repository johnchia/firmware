# Hi3516CV608 on 8 MB NOR, running Raptor on the V5 backend.
#
# WHY THE NAME IS NOW LITERAL. raptor-hal used to carry one HiSilicon backend,
# src/hisi_v4, which declares the gen-4 HiMPP ABI itself in v4_*.h and dlopens
# libmpi.so against it. The CV608 is V5: a different MPP with ot_*-prefixed
# entry points, encode-only (no VO, no TDE, no NNIE -- see the CHIPARCH arms in
# hisilicon-opensdk.mk), one libss_mpi.so where gen4 had libmpi, and MMZ moved
# back out of OSAL. That is a second backend rather than #ifdefs in the first,
# and src/hisi_v5 is it. This target is where it landed.
#
# Nothing here selects that backend. raptor-hal keys it off PLATFORM, and
# raptor-streaming.mk already maps the hi3516cv6xx family to HI3516CV610 -- the
# name the MPP gives itself on either die -- so the family picks it.
#
# ONE FAMILY, TWO DIES. SOC_FAMILY is hi3516cv6xx because that is what selects
# the kernel branch, the toolchain, the board directory, the Majestic tarball
# and the repack path; SOC_MODEL is the die, so the image is named for the part
# it was built for and a CV608 matches it directly on upgrade. That is also why
# BR2_OPENIPC_SOC_ALIASES is absent here and present on hi3516cv6xx_ultimate:
# the shared image needs a route from either die's reported id, a per-die image
# does not.
#
# ITS FLASH IS THE CONSTRAINT, THE SAME WAY THE EV200'S IS. 7360K holds the
# kernel and the rootfs together on this board -- see BR2_OPENIPC_FLASH_SIZE --
# so weigh anything added below against 7360k total, not against the 8192k
# repack prints. It used to be tight enough to exclude hisilicon-opensdk: the
# FIT was 2688k and the rootfs 5388k with opensdk in, which overran the region
# however it was cut. Forking the kernel config (hi3516cv608.raptor.config)
# took the FIT to 1984k and 620k of dead modules out of the squashfs, 1331k off
# the pair, and the table was re-cut to bank it -- kernel slot back to 2048k,
# every freed block to the rootfs. opensdk fits in the result at 4792k of a
# 5056k slot. It would not fit the old 4352k one, so the two changes are what
# bought the driver stack and neither would have done it alone.
#
# BOARD-VERIFIED, BUT ON THE PREVIOUS CUT. An H4-52POX-S CV608 boots this image
# to a root shell with the OEM U-Boot left in place, from an environment saved
# to mtd1 and with no serial console attached; rootfs_data mounts jffs2 there,
# so a root password set through openipc-claim survives a reboot. /proc/mtd
# reported a 00010000 erase size, which is where the 64K granularity in the
# sizing above comes from.
#
# The re-cut table below -- 2048K kernel, 5056K rootfs, banking the
# kernel-config fork -- has since been flashed to that board with opensdk in
# the image, and it boots. Note it could not be delivered as a rootfs upgrade:
# partition starts move, so the env and both partitions had to be written
# together, rootfs beginning at 0x240000 rather than 0x2F0000. rootfs_data and
# devinfo start at the same offsets under either table, which is what let the
# overlay survive the change.
#
# Still unverified: nothing has streamed. Majestic is out for space and Raptor
# has no V5 backend, so no process in this image opens a stream -- what opensdk
# buys is the kernel side underneath one.
#
# Declaring env in that table is what lets fw_printenv work, and the mechanism
# is worth knowing because it leaves a file behind that the image did not ship.
# all-patches/uboot-tools/0011-env-partition-autosearch.patch CRC-scans the
# partitions in /proc/mtd when /etc/fw_env.config is missing, and on a hit
# WRITES that file with what it found -- so /etc/fw_env.config appearing on a
# running camera is the patch's cache, not something from this tree.
#
# A cut-down table that omits env leaves the environment in no mtd device for
# the scan to find, and every fw_printenv reader in the overlay -- rcS for
# sensor and ethaddr, S40network for the wlan keys -- then falls back silently.
# On this board that is visible from the outside: with env declared the
# hostname suffix follows the OEM ethaddr, and without it a MAC is generated
# and the suffix changes.
#
# If autosearch ever picks the wrong partition, the fix is a board overlay
# carrying /etc/fw_env.config, the way br-ext-chip-ingenic/board/t31 does it.

# Architecture
BR2_arm=y
BR2_cortex_a7=y
BR2_ARM_EABI=y
BR2_ARM_FPU_NEON_VFPV4=y
BR2_ARM_INSTRUCTIONS_THUMB2=y

# Toolchain
BR2_TOOLCHAIN_EXTERNAL=y
BR2_TOOLCHAIN_EXTERNAL_DOWNLOAD=y
BR2_TOOLCHAIN_EXTERNAL_URL="https://github.com/openipc/firmware/releases/download/$(OPENIPC_TOOLCHAIN).tgz"
BR2_TOOLCHAIN_EXTERNAL_CUSTOM_PREFIX="arm-openipc-linux-musleabi"
BR2_TOOLCHAIN_EXTERNAL_HEADERS_5_10=y
BR2_TOOLCHAIN_EXTERNAL_CUSTOM_MUSL=y
BR2_GCC_VERSION_13_X=y
BR2_TOOLCHAIN_EXTERNAL_CXX=y

# Kernel
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_TARBALL=y
# PINNED, NOT TRACKED, for the reason the other two raptor boards are: a
# bring-up that cannot say which kernel it ran is not evidence, and a branch
# name would mean one filename forever against a download cache that keys on
# the filename. hi3516cv6xx_ultimate tracks the branch; this does not, so the
# two can and will diverge.
#
#   git ls-remote https://github.com/openipc/linux refs/heads/hisilicon-hi3516cv6xx
BR2_LINUX_KERNEL_CUSTOM_TARBALL_LOCATION="https://github.com/openipc/linux/archive/533467722c14ef76507d15352ee0a9a9a331c11f.tar.gz"
BR2_LINUX_KERNEL_USE_CUSTOM_CONFIG=y
# The family config, spelled out rather than derived from SOC_MODEL: there is
# one kernel config for both dies and no hi3516cv608.generic.config to find.
BR2_LINUX_KERNEL_CUSTOM_CONFIG_FILE="$(EXTERNAL_VENDOR)/board/$(OPENIPC_SOC_FAMILY)/hi3516cv608.raptor.config"
BR2_LINUX_KERNEL_ZIMAGE=y
BR2_LINUX_KERNEL_XZ=y
BR2_LINUX_KERNEL_UIMAGE_LOADADDR="0x40018000"
BR2_LINUX_KERNEL_DTS_SUPPORT=y
# BR2_LINUX_KERNEL_DTB_IS_SELF_BUILT is not set
# Not the in-tree demo-board tree: that one enables eMMC on mmc0 and WiFi on
# sdio1, and sdio1's pads are GPIO1_0..1_3 and GPIO7_6/7_7 -- the OEM's IR-cut,
# LED, CDS and reset lines -- which the SD driver takes away from GPIO at
# probe. The board tree includes the demo tree and flips the three SD nodes to
# what the hardware has (microSD on sdio0, nothing else). Buildroot copies it
# into the kernel's dts directory, so the #include resolves in-tree, and builds
# it under its own basename; INTREE_DTS_NAME stays empty so that
# post-image.sh's hi35*.dtb glob finds exactly one file.
BR2_LINUX_KERNEL_INTREE_DTS_NAME=""
BR2_LINUX_KERNEL_CUSTOM_DTS_PATH="$(EXTERNAL_VENDOR)/board/$(OPENIPC_SOC_FAMILY)/hi3516cv608-raptor.dts"
# Two scripts, size check first so it fails before the FIT is assembled.
# post-image.sh builds the FIT (zImage + dtb) and concatenates rootfs.squashfs
# onto it at the next 64K boundary; that firmware.bin is what repack ships.
#
# The combined blob is a transport, NOT the layout on the chip. sysupgrade's
# do_update_firmware splits it back at the FIT boundary and writes each half to
# its own partition whenever the flash has both, which this one does -- so the
# caps that matter are the partitions', below, not the blob's.
BR2_ROOTFS_POST_IMAGE_SCRIPT="$(BR2_EXTERNAL)/scripts/check-rootfs-size.sh $(EXTERNAL_VENDOR)/board/$(OPENIPC_SOC_FAMILY)/post-image.sh"

# Filesystem
BR2_PACKAGE_BUSYBOX_CONFIG="$(BR2_EXTERNAL)/package/busybox/busybox.config"
BR2_PACKAGE_UBOOT_TOOLS=y
# libcurl links libz and nothing else here enables it, so without this the
# image ships a libcurl.so.4 and a curl that cannot load at all -- and the
# first thing to notice is sysupgrade --url failing on "Error loading shared
# library libz.so.1", by which point the camera is mid-upgrade.
BR2_PACKAGE_ZLIB=y
# BR2_PACKAGE_IFUPDOWN_SCRIPTS is not set
BR2_PACKAGE_WIREGUARD_LINUX_COMPAT=y
BR2_PACKAGE_WIREGUARD_TOOLS=y
BR2_TARGET_ROOTFS_SQUASHFS=y
BR2_TARGET_ROOTFS_SQUASHFS4_XZ=y

# OpenIPC
BR2_OPENIPC_SOC_VENDOR="hisilicon"
BR2_OPENIPC_SOC_MODEL="hi3516cv608"
BR2_OPENIPC_SOC_FAMILY="hi3516cv6xx"
BR2_OPENIPC_VARIANT="raptorwifi"
BR2_OPENIPC_FLASH_SIZE="8"
# THE FLASH LAYOUT IS OPENIPC'S, from the default environment of
# OpenIPC/u-boot-hi3516cv6xx (include/configs/hi-common.h):
#
#   sfc:256k(boot),64k(env),2048k(kernel),5120k(rootfs),7168k@0x50000(firmware),-(rootfs_data)
#   root=/dev/mtdblock3
#
# boot at 0x0, env 0x40000, kernel 0x50000, rootfs 0x250000, and the overlay
# from 0x750000 to the end of the chip, 704K. firmware overlaps kernel and
# rootfs: it is the whole-image slot U-Boot's fwupd writes. Matching OpenIPC is
# the point -- its sysupgrade, its recovery steps and its U-Boot work on this
# board as on any OpenIPC camera -- and hi3516cv608_raptor made the
# move first; the two targets differ in the radio, not the chip.
#
# This target used to keep the H4-52POX-S's OEM bootloader and a re-cut of its
# table, 192K(uboot),64K(env),2048K(kernel),5184K(rootfs),640K(rootfs_data),
# 64K(devinfo), because the rootfs with the wifi stack and two sensors in it
# needed the 64K past 5120. Pinning the sensor (below) is what gave it back:
# with one it is 5096K, 24K short of the cap, and the second sensor's driver
# alone is 88K before compression.
# Moving a board from that table onto this one is a full flash, bootloader
# included (sysupgrade-raptor --full -n), and the overlay does not survive
# it. Nor does devinfo: the OEM's 64K identity partition at the end of the
# chip sits inside rootfs_data here, and the first jffs2 format takes it. It
# held the identity of OEM software this image does not carry.
#
# rootfs_data IS THE OVERLAY AND THE NAME IS LOAD-BEARING. general/overlay/init
# greps /proc/mtd for exactly that string, mounts it jffs2, formats it with
# flash_eraseall on first boot, and overlays it on /. With no such partition it
# falls through to a tmpfs and every change to /etc is lost on reboot -- which
# looks like a working overlay right up until the camera is power-cycled.
#
# THE KERNEL SLOT HAS NO SPARE ERASE BLOCK. The FIT is 2006K (build 7e44ca95),
# inside the last of the slot's 32 blocks with 42K to go. Nothing enforces the
# slot: check-rootfs-size.sh covers the rootfs only and says so in its own
# header, repack's CHECK_SIZE measures the combined blob against the whole chip
# on this family, and only `make fullimage` refuses a FIT that does not fit. A
# kernel that grows past 2048K overruns into the rootfs by sysupgrade with no
# build-time complaint -- check the FIT by hand after any kernel bump.
#
# 5120 is OpenIPC's rootfs, and the other 8 MB targets'.
BR2_OPENIPC_ROOTFS_PART_KB="5120"
# One sensor, the OS04D10 the H4-52POX-S carries, after ssc333_sc3336_raptor.
# hisilicon-opensdk ships that driver alone, hisilicon-osdrv-hi3516cv6xx its
# mode INI and IQ tuning alone, and the image is named for it:
# openipc.hi3516cv608_os04d10-nor-raptorwifi. raptor probes the sensor at
# runtime either way, so a board with a different part still streams; it
# falls back to generic tuning and the colour is wrong.
BR2_OPENIPC_SNS_MODEL="os04d10"

# OpenIPC's U-Boot reads a valid environment off flash in place of its
# compiled-in default, so the image ships one: that default with the values
# this board needs, in a text file readable back off the chip. mkenvimage turns
# it into images/uboot-env.bin. (openipc.fragment already sets
# BR2_PACKAGE_HOST_UBOOT_TOOLS.)
BR2_PACKAGE_HOST_UBOOT_TOOLS_ENVIMAGE=y
BR2_PACKAGE_HOST_UBOOT_TOOLS_ENVIMAGE_SOURCE="$(BR2_EXTERNAL)/../br-ext-chip-hisilicon/board/$(OPENIPC_SOC_FAMILY)/hi3516cv608.raptor.env.txt"
BR2_PACKAGE_HOST_UBOOT_TOOLS_ENVIMAGE_SIZE="0x10000"

# The bootloader, built here from OpenIPC's tree with its own defconfig,
# unmodified but for a packaging patch. hisilicon-cv6xx-boot packs it with the
# GSL built from the same tree and the board's DDR table into the image the
# boot ROM loads, and installs that as images/u-boot-hi3516cv608-nor.bin for
# `make fullimage`. It is not in the sysupgrade tarball: mtd0 has no software
# recovery short of the boot ROM's UART download.
BR2_TARGET_UBOOT=y
BR2_TARGET_UBOOT_BUILD_SYSTEM_KCONFIG=y
BR2_TARGET_UBOOT_CUSTOM_TARBALL=y
# Pinned by commit; OpenIPC/u-boot-hi3516cv6xx main stood here. Bumping the
# line is what moves it, and the hash in all-patches/uboot/uboot.hash says which
# bytes that commit must arrive as.
BR2_TARGET_UBOOT_CUSTOM_TARBALL_LOCATION="https://github.com/OpenIPC/u-boot-hi3516cv6xx/archive/ab5d86d558dd9fce90748177cc01b54939560645.tar.gz"
# Spelled out, not built from $(OPENIPC_SOC_MODEL): uboot.mk checks it at parse
# time, before external.mk defines that (see ssc377d_raptor_defconfig).
# hisilicon-cv6xx-boot asserts the two agree.
BR2_TARGET_UBOOT_BOARD_DEFCONFIG="hi3516cv608_openipc"
# The packed boot image, not u-boot.bin, so a build that produced none fails
# rather than quietly installing nothing. The bare u-boot.bin is left out of
# images/ altogether: the boot ROM does not boot it, so the only thing it can do
# there is be written to mtd0 by mistake.
# BR2_TARGET_UBOOT_FORMAT_BIN is not set
BR2_TARGET_UBOOT_FORMAT_CUSTOM=y
BR2_TARGET_UBOOT_FORMAT_CUSTOM_NAME="boot-image.bin"
BR2_TARGET_UBOOT_PATCH="$(BR2_EXTERNAL)/package/hisilicon-cv6xx-boot/patches"
BR2_PACKAGE_HISILICON_CV6XX_BOOT=y

# Packages
#
# WHAT ENCODES HERE IS RAPTOR, and only raptor. Majestic stays out: it is the
# other streamer rather than a companion, and this partition has no room for
# both. hisilicon-opensdk is in: it builds every open_*.ko that
# load_hisilicon modprobes by name -- open_osal, open_mmz, open_isp,
# open_sys_config and the rest, 42 modules -- so the load script can now get
# past its first modprobe, which is the step this target exists to reach.
#
# It also brings the six source-built sensor drivers (gc4023, os04d10, sc4336p,
# sc450ai, sc500ai, sc431hai) alongside the two blobs osdrv installs, imx307
# and os02m10.
#
# This is what makes the MMZ arithmetic in hi3516cv608.raptor.env.txt live rather than
# latent. Until now load_hisilicon died before open_mmz was ever modprobed, so
# a wrong mmz= was harmless; from here it is handed to the driver.
#
# osdrv separately carries a vendor ot_*.ko set in files/kmod/ that its
# INSTALL_TARGET_CMDS does not install. That set is not needed now that opensdk
# builds the open_*.ko equivalents.
#
# Majestic's exclusive dependencies leave with it: libevent, libogg, the
# ot_opus_* shim that exists for the V5 naming Majestic wanted, and protobuf-c,
# which only the cv6xx Majestic build dlopens. opus itself is back, because
# raptor's rad wants it. libyaml stays
# because yaml-cli selects it, json-c because jsonfilter uses it, and
# mbedtls because libcurl is built against it.
#
# Wireless, for an RTL8733BU (0bda:b733) on the USB port. The stock cv6xx
# kernel has CONFIG_WIRELESS off, which is why this was impossible before; the
# forked kernel config turns it on with cfg80211 as a MODULE, because the FIT
# has one 64K block of slack and anything built in overruns the kernel slot.
# The driver's id table matches 0xB733 (multi-function) and 0xF72B (WiFi only)
# under CONFIG_RTL8733B, which its Makefile sets from CONFIG_RTL8733BU.
#
# THIS IS WHY THE VARIANT EXISTS, and it is a fifth of the rootfs: 543 KB of
# driver, 109 KB of cfg80211, 455 KB of supplicant and 57 KB of tools, 1150 KB
# compressed against a 5184 KB slot. The only other difference from
# hi3516cv608_raptor is what had to leave to pay for it: mosquitto,
# below.
# The cv608 has no standard radio, so the wired build is the one that does not
# assume this dongle, and a board with a different one needs its own arm in
# /etc/wireless/usb rather than this defconfig. Nothing has to set wlandev for
# this image, though: with the driver in it and a dongle on the bus,
# /etc/wireless/detect finds the arm at boot.
BR2_PACKAGE_DROPBEAR_OPENIPC=y
BR2_PACKAGE_HISILICON_OPENSDK=y
BR2_PACKAGE_HISILICON_OSDRV_HI3516CV6XX=y
BR2_PACKAGE_IPCTOOL=y
BR2_PACKAGE_JSONFILTER=y
BR2_PACKAGE_LIBCURL_OPENIPC=y
BR2_PACKAGE_LIBCURL_OPENIPC_CURL=y
BR2_PACKAGE_LIBCURL_OPENIPC_MBEDTLS=y
# BR2_PACKAGE_LIBCURL_OPENIPC_PROXY_SUPPORT is not set
# BR2_PACKAGE_LIBCURL_OPENIPC_COOKIES_SUPPORT is not set
# BR2_PACKAGE_LIBCURL_OPENIPC_EXTRA_PROTOCOLS_FEATURES is not set
BR2_PACKAGE_MBEDTLS_OPENIPC=y
BR2_PACKAGE_MOTORS=y
# Buildroot's own opus, which BR2_PACKAGE_RAPTOR_STREAMING selects. Fixed
# point because this is a soft-float userland with no FPU calling convention;
# it is the same arithmetic opus-openipc was built with here before.
BR2_PACKAGE_OPUS_FIXED_POINT=y
# compy, faac, helix-aac, libschrift, majestic-fonts and opus arrive through
# this symbol's selects.
BR2_PACKAGE_RAPTOR_STREAMING=y
BR2_PACKAGE_RTL8733BU_OPENIPC=y
BR2_PACKAGE_VTUND_OPENIPC=y
BR2_PACKAGE_WIRELESS_TOOLS=y
BR2_PACKAGE_WPA_SUPPLICANT=y
BR2_PACKAGE_WPA_SUPPLICANT_CLI=y
# No wpa_passphrase. /etc/wireless/wpa-conf replaced it -- its own comment says
# so -- and writes psk="..." for the supplicant to derive, or passes a 64-hex
# wlanpass through as a pre-derived key, which wpa_passphrase cannot even
# accept. Nothing in the overlay, the packages or raptor execs the binary, so
# on this board it is 30 KB of a 5184 KB slot doing nothing.
# Setup mode raises an access point of its own, and this is what lets the
# supplicant be one: `mode=2` in a network block is rejected without it. No
# hostapd, on the same reasoning as the ssc333 and t31 targets -- one binary
# serves both modes.
#
# 8733bu registers rtw_cfg80211_ops the way 8188fu does, so -D nl80211 is the
# right driver for it; that it beacons has not been shown on this board.
BR2_PACKAGE_WPA_SUPPLICANT_AP_SUPPORT=y
BR2_PACKAGE_YAML_CLI=y

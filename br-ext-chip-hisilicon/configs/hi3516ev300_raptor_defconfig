# Hi3516EV300, Raptor in place of Majestic. Derived from hi3516ev300_lite, and
# the family it builds against is hi3516ev200 -- one MPP tree covers both parts,
# which is measured rather than assumed: an EV300 reports
# "Hi3516EV200_MPP_V1.0.1.2 B030" on every /proc/umap node. That is why PLATFORM
# reaches raptor as HI3516EV200 while SOC_MODEL below stays hi3516ev300 -- the
# family picks the backend, the part picks the caps.
#
# NOT BOARD-VERIFIED. The gen4 backend builds and links; nothing here has
# streamed on an EV300.

# Architecture
#
# NOTE THE TUPLE: musleabi, not musleabihf. Gen4 HiSilicon userland is
# soft-float -- Tag_ABI_VFP_args is absent from every vendor library on a stock
# board while Tag_FP_arch reads VFPv4, so the FPU is used and the calling
# convention is not. A hard-float build links, loads, runs, and hands garbage to
# every float argument crossing into MPI. raptor-hal carries a #error on
# __ARM_PCS_VFP so the mistake cannot survive a compile; this is the config side
# of the same constraint, and it is why the toolchain below is not the one the
# SigmaStar raptor boards use.
BR2_arm=y
BR2_cortex_a7=y
BR2_ARM_EABI=y
BR2_ARM_FPU_NEON_VFPV4=y
BR2_ARM_INSTRUCTIONS_THUMB2=y

# Toolchain
#
# Upstream's, at the moving URL, and deliberately not the dated mirror the
# SigmaStar raptor boards fetch from: that mirror carries the three SigmaStar
# families only. Mirroring this one is the same job done again for hisilicon and
# is worth doing before anything here is verified on hardware -- until then a
# rebuilt toolchain changes the compiler under a port that has no known-good
# reference to compare against.
BR2_TOOLCHAIN_EXTERNAL=y
BR2_TOOLCHAIN_EXTERNAL_DOWNLOAD=y
BR2_TOOLCHAIN_EXTERNAL_URL="https://github.com/openipc/firmware/releases/download/$(OPENIPC_TOOLCHAIN).tgz"
BR2_TOOLCHAIN_EXTERNAL_CUSTOM_PREFIX="arm-openipc-linux-musleabi"
BR2_TOOLCHAIN_EXTERNAL_HEADERS_4_9=y
BR2_TOOLCHAIN_EXTERNAL_CUSTOM_MUSL=y
BR2_TOOLCHAIN_EXTERNAL_CXX=y

# Kernel
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_TARBALL=y
# PINNED, NOT TRACKED, for the reason the SigmaStar raptor boards are: a branch
# name in this URL means one filename forever, and Buildroot caches a download
# by filename and does not re-fetch. A commit makes the filename change when the
# source does, and makes the tarball in dl/linux/ answer which one it is.
#
# The branch is still where new work lands:
#   git ls-remote https://github.com/openipc/linux refs/heads/hisilicon-hi3516ev200
BR2_LINUX_KERNEL_CUSTOM_TARBALL_LOCATION="https://github.com/openipc/linux/archive/e66720e0778e0b3f7488e635b512f0e6290626cd.tar.gz"
BR2_LINUX_KERNEL_USE_CUSTOM_CONFIG=y
BR2_LINUX_KERNEL_CUSTOM_CONFIG_FILE="$(EXTERNAL_VENDOR)/board/$(OPENIPC_SOC_FAMILY)/hi3516ev300.generic.config"
BR2_LINUX_KERNEL_UIMAGE=y
BR2_LINUX_KERNEL_XZ=y

# Filesystem
BR2_PACKAGE_BUSYBOX_CONFIG="$(BR2_EXTERNAL)/package/busybox/busybox.config"
BR2_PACKAGE_UBOOT_TOOLS=y
BR2_PACKAGE_ZLIB=y
# BR2_PACKAGE_IFUPDOWN_SCRIPTS is not set
BR2_PACKAGE_WIREGUARD_LINUX_COMPAT=y
BR2_PACKAGE_WIREGUARD_TOOLS=y
BR2_TARGET_ROOTFS_SQUASHFS=y
BR2_TARGET_ROOTFS_SQUASHFS4_XZ=y
# Fail the build, not the flash, when the rootfs outgrows its partition. The
# limit is BR2_OPENIPC_ROOTFS_PART_KB below.
BR2_ROOTFS_POST_IMAGE_SCRIPT="$(BR2_EXTERNAL)/scripts/check-rootfs-size.sh"

# OpenIPC
BR2_OPENIPC_SOC_VENDOR="hisilicon"
BR2_OPENIPC_SOC_MODEL="hi3516ev300"
BR2_OPENIPC_SOC_FAMILY="hi3516ev200"
BR2_OPENIPC_VARIANT="raptor"
BR2_OPENIPC_FLASH_SIZE="16"
# 5120, from the bootloader rather than from the chip size. u-boot-hi3516ev200
# carries mtdparts as a plain environment variable with a compiled-in default
# (include/configs/hi-common.h):
#
#   mtdparts=hi_sfc:256k(boot),64k(env),2048k(kernel),5120k(rootfs),-(rootfs_data)
#
# Nothing reads the squashfs superblock, so there is no sizing-by-image the way
# SigmaStar's cmd_sf.c does it -- the table is whatever the env says, and the
# default is the one above. The larger layout exists but is a deliberate act at
# the u-boot prompt (`setnor16m`), and it is 10240k with a 3072k kernel at a
# different rootfs offset, not a bigger mtd3:
#
#   mtdparts=hi_sfc:256k(boot),64k(env),3072k(kernel),10240k(rootfs),-(rootfs_data)
#
# So 5120 and 10240 are the only two real values here. This said 8192 first,
# which is a SigmaStar number and belongs to no HiSilicon layout at all; a
# 5356KB rootfs passed that guard and could not be mounted by a kernel told its
# rootfs was 5120k. A limit larger than the partition is not a limit -- it moves
# the failure from the build, where it is a number, to the flash, where it is a
# camera nobody can reach.
#
# 10240 IS NOT THE DEFAULT LAYOUT. A camera only has this partition table after
# something has set the env -- `setnor16m` at the u-boot prompt, or a full image
# that carries the env with it. Flashed onto a board still running the
# compiled-in nor8m table, an image built to this limit is the 5120k failure
# again, and it also lands at the wrong offset: nor16m puts the rootfs at
# 0x350000, not 0x250000, because its kernel partition is 3072k rather than
# 2048k. Check /proc/mtd, or flash the full image that sets both.
BR2_OPENIPC_ROOTFS_PART_KB="10240"

# Packages
#
# Raptor owns the camera here as it does on the SigmaStar boards: the HAL
# dlopens the HiMPP libraries the osdrv package installs rather than linking
# them, so there is no SDK to have present at build time and the binary binds to
# whichever MPP the device carries. That is also why this board pulls in no
# headers package -- the backend declares the HiMPP ABI itself in
# raptor-hal/src/hisi_v4/v4_*.h.
#
# Majestic is carried as a reference encoder rather than a streamer -- the
# second opinion when MPP refuses something and it is not clear whether the
# fault is Raptor's or the SoC's, which during a bring-up is most of the time. A
# post-build hook renames its init script to K95majestic so it does not take the
# MPP devices before S95raptor; run it by hand after stopping raptor.
#
# It fits because the partition above is the 10240k one. At 5120k it does not,
# and the choice between the two is the choice between having this and not.
BR2_PACKAGE_DROPBEAR_OPENIPC=y
BR2_PACKAGE_HISILICON_OPENSDK=y
BR2_PACKAGE_HISILICON_OSDRV_HI3516EV200=y
BR2_PACKAGE_IPCTOOL=y
BR2_PACKAGE_JSONFILTER=y
BR2_PACKAGE_LIBCURL_OPENIPC=y
BR2_PACKAGE_LIBCURL_OPENIPC_CURL=y
# BR2_PACKAGE_LIBCURL_OPENIPC_PROXY_SUPPORT is not set
# BR2_PACKAGE_LIBCURL_OPENIPC_COOKIES_SUPPORT is not set
# BR2_PACKAGE_LIBCURL_OPENIPC_EXTRA_PROTOCOLS_FEATURES is not set
BR2_PACKAGE_LIBEVENT_OPENIPC=y
BR2_PACKAGE_LIBOGG_OPENIPC=y
BR2_PACKAGE_MAJESTIC=y
BR2_PACKAGE_MAJESTIC_FONTS=y
BR2_PACKAGE_MBEDTLS_OPENIPC=y
BR2_PACKAGE_MOSQUITTO=y
# BR2_PACKAGE_MOSQUITTO_BROKER is not set
BR2_PACKAGE_MOTORS=y
BR2_PACKAGE_OPUS_OPENIPC=y
BR2_PACKAGE_OPUS_OPENIPC_FIXED_POINT=y
BR2_PACKAGE_RAPTOR_STREAMING=y
BR2_PACKAGE_VTUND_OPENIPC=y
BR2_PACKAGE_YAML_CLI=y

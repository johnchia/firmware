config BR2_PACKAGE_RAPTOR_STREAMING
	bool "Raptor streaming system"
	select BR2_PACKAGE_COMPY
	select BR2_PACKAGE_FAAC
	select BR2_PACKAGE_HELIX_AAC
	select BR2_PACKAGE_LIBSCHRIFT
	select BR2_PACKAGE_MAJESTIC_FONTS
	select BR2_PACKAGE_OPUS
	help
	  Multi-daemon streaming system: video, RTSP, audio, OSD and
	  day/night control, talking to the SoC through a pluggable HAL.

	  This package has no download site. Raptor is developed as
	  sibling repositories and the SigmaStar backend is not upstream
	  yet, so a local checkout must be supplied:

	    make BOARD=<board> RAPTOR_SRCDIR=/path/to/parent raptor-local

	  https://github.com/gtxaspec/raptor

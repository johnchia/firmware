diff --git a/CMakeLists.txt b/CMakeLists.txt
index d97e164..ecf9797 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -205,3 +205,14 @@ if(COMPY_TLS_COUNT EQUAL 1)
 endif()
 
 set_target_properties(${PROJECT_NAME} PROPERTIES C_STANDARD 99 C_STANDARD_REQUIRED ON)
+
+# Upstream ships no install() rules -- it only supports being consumed
+# in-tree via add_subdirectory()/FetchContent. Buildroot needs a
+# conventional staged lib+headers so a plain-Makefile consumer (e.g.
+# Divinus) can link against -lcompy without embedding this CMake
+# project. slice99/metalang99/datatype99/interface99 are header/macro
+# only (no compiled objects of their own -- verified empty *_SOURCES
+# lists produce no separate .a), so libcompy.a is self-contained and
+# nothing else needs installing.
+install(TARGETS ${PROJECT_NAME} ARCHIVE DESTINATION lib)
+install(DIRECTORY include/ DESTINATION include)

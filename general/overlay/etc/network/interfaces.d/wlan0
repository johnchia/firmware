# The supplicant configuration is generated rather than written inline, so that
# a pre-derived 64-hex PSK is accepted alongside a passphrase and wpa_cli has a
# control socket to talk to. See /etc/wireless/wpa-conf.
iface wlan0 inet dhcp
    pre-up /etc/wireless/wpa-conf > /tmp/wpa_supplicant.conf
    pre-up wpa_supplicant -B -i wlan0 -D nl80211,wext -c /tmp/wpa_supplicant.conf
    post-down killall -q wpa_supplicant

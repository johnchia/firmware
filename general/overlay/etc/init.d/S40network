#!/bin/sh
dev=$(fw_printenv -n wlandev)
mac=$(fw_printenv -n wlanmac)
net=$(fw_printenv -n netaddr_fallback)
eth=$(fw_printenv -n ethaddr)

set_wireless() {
	path=/etc/wireless
	if $path/usb "$dev" || $path/sdio "$dev"; then
		[ -n "$mac" ] && ip link set dev wlan0 address "$mac"
		ifup wlan0
	elif $path/modem "$dev"; then
		ifup usb0
		ifup eth1
	fi
	# A camera with a radio may still have a socket, and some do. With a
	# cable in it eth0 takes a lease like any other interface, and the
	# metrics in interfaces.d decide which of the two carries the default
	# route -- wire first, radio as the fallback.
	#
	# With no cable it keeps the static address that has always been here.
	# That is the bench address a wireless camera is recovered on, and on a
	# board whose EMAC has no socket wired to it there is nothing to
	# negotiate with, so asking udhcpc would only spend its five retries.
	if [ -e /sys/class/net/eth0 ]; then
		if /etc/network/wired-carrier 30; then
			ifup eth0
		else
			ifconfig eth0 "${net:-192.168.2.10}" hw ether "${eth:-00:00:23:34:45:66}" up
		fi
	fi
}

start() {
	echo "Starting network..."
	ifup lo
	if [ -n "$dev" ]; then
		set_wireless
	else
		ifup eth0
	fi
}

stop() {
	echo "Stopping network..."
	ifdown lo
	ifdown -f wlan0
	ifdown -f usb0
	ifdown -f eth1
	ifdown -f eth0
}

case "$1" in
	start|stop)
		$1
		;;

	restart|reload)
		stop
		start
		;;

	*)
		echo "Usage: $0 {start|stop|restart|reload}"
		exit 1
		;;
esac

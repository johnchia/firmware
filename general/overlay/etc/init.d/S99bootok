#!/bin/sh
# Disarm the bootloader's boot-count recovery once the camera has reached a
# healthy userspace. sysupgrade sets upgrade_available=1 before a flash; a
# U-Boot that supports boot-count recovery keeps counting boots until this
# clears the flag, and reflashes a known-good image if a broken one never gets
# here. On a U-Boot without boot-count logic the variable is ignored, so this
# is a no-op beyond one environment read. A normal (unarmed) boot costs a
# single fw_printenv and writes nothing.
case "$1" in
	start|"") ;;
	*) exit 0 ;;
esac

command -v fw_printenv >/dev/null 2>&1 || exit 0
[ "$(fw_printenv -n upgrade_available 2>/dev/null)" = "1" ] || exit 0

# Armed. Disarm only once the new image is PROVEN healthy -- and prove it,
# don't just glimpse it. What gets proven here is that something is serving
# RTSP, not that a particular binary exists: this fork ships raptor rather than
# majestic, and a check written around one streamer's process name goes quietly
# blind the moment the image carries the other. A listening socket is the
# service, whoever provides it.
#
# 554 is hardcoded on purpose. Reading the port back out of a config file would
# tie this to one streamer's configuration format, which is the coupling the
# port check exists to avoid; a camera moved off the default port, or onto
# RTSPS, will not disarm and gets recovered instead. That is the safe direction
# to be wrong in, and it is a deliberate trade.
#
# The socket also binds on an unclaimed camera -- authentication is per-request
# -- which matters because `sysupgrade -n` wipes the overlay and arms recovery
# in the same breath. A health check that needed a successful stream would call
# a freshly wiped camera dead and reflash it.
#
# Require the socket to stay up across a sustained window; if it goes the
# window restarts, and if it never holds we leave the flag armed so U-Boot
# escalates to recovery instead of looping on an image that boots but does not
# stream. Backgrounded so nothing here holds up boot.
{
	# LISTEN is state 0A, and local_address is <hex addr>:<hex port>;
	# 554 is 022A. /proc rather than netstat: no dependency, no output to
	# parse, and it costs one read.
	nets=/proc/net/tcp
	[ -e /proc/net/tcp6 ] && nets="$nets /proc/net/tcp6"

	need=8       # consecutive good checks (~16s) before trusting the image
	ok=0
	tries=0
	while [ "$tries" -lt 90 ]; do
		if awk '$4 == "0A" && $2 ~ /:022A$/ { f = 1 } END { exit !f }' \
			$nets 2>/dev/null; then
			ok=$((ok + 1))
			if [ "$ok" -ge "$need" ]; then
				if fw_setenv upgrade_available 0 2>/dev/null &&
					fw_setenv bootcount 0 2>/dev/null; then
					exit 0
				fi
				# Environment readable but not writable: say so, or every
				# healthy boot silently leaves U-Boot counting toward recovery.
				logger -s -t bootok "healthy but could not clear upgrade_available (U-Boot env not writable) -- bootloader will keep counting" 2>/dev/null
				exit 0
			fi
		else
			ok=0
		fi
		sleep 2
		tries=$((tries + 1))
	done
	logger -s -t bootok "nothing held a listener on RTSP 554; leaving boot-count recovery armed" 2>/dev/null
} &

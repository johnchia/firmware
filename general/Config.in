config BR2_OPENIPC_SOC_VENDOR
	string "SoC vendor"

config BR2_OPENIPC_SOC_MODEL
	string "SoC model"

config BR2_OPENIPC_SOC_ALIASES
	string "Interchangeable SoC ids served by this image"
	help
	  Space-separated retired/hardware-compatible SoC ids that this build's
	  SOC_MODEL also serves (e.g. "hi3516cv610 hi3516cv608" on the cv6xx
	  image, or "xm550" on the xm530 image). Read by
	  .github/scripts/enrich_manifest.py to emit @alias records so on-device
	  sysupgrade routes a camera still reporting the old id to the image
	  actually published under SOC_MODEL.

config BR2_OPENIPC_SOC_FAMILY
	string "SoC family"

config BR2_OPENIPC_SNS_MODEL
	string "Sensor model"

config BR2_OPENIPC_CAMERA
	string "Camera"
	help
	  Set only by a camera fragment, br-ext-chip-<vendor>/cameras/<camera>/
	  camera.conf, to the directory's own name: <identity>_<soc>_<sensor>_
	  <radio>. Names the image archive (openipc.<camera>-nor-<variant>) and
	  is stamped into os-release as BUILD_CAMERA so the camera-side updater
	  can compose that name back. Empty on an SoC target.

config BR2_OPENIPC_CAMERA_BASE
	string "Camera base target"
	help
	  The SoC target a camera fragment layers on, as <soc>_<variant>; the
	  Makefile reads it out of camera.conf to find the defconfig. A camera
	  may set only camera facts over its base (the allowlist is in
	  .github/scripts/test_cameras.sh); a fragment that wants more is an
	  SoC target in disguise.

config BR2_OPENIPC_VARIANT
	string "OpenIPC variant"

config BR2_OPENIPC_FLASH_SIZE
	string "OpenIPC flash size"

config BR2_OPENIPC_ROOTFS_PART_KB
	string "OpenIPC rootfs partition size in KB"
	help
	  Size of the rootfs MTD partition in KB, for boards whose partition
	  table does not follow from the size of the flash chip -- a 16MB NOR
	  that gives the rootfs 5MB and the remaining 8.5MB to the overlay, for
	  example. The build's size limit is a property of the partition the
	  image has to fit in, not of the chip.

	  Leave empty to derive the limit from BR2_OPENIPC_FLASH_SIZE as before.

config BR2_OPENIPC_MAJESTIC
	string "OpenIPC Majestic"
	default "lite"

source "$BR2_EXTERNAL_GENERAL_PATH/package/Config.in"

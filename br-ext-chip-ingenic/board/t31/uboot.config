# Run the "preboot" environment variable before bootcmd.
#
# main_loop() calls run_preboot_environment_command() ahead of
# process_button_cmds() and autoboot_command(), so preboot executes whatever
# happens to bootcmd afterwards. That matters on a camera with no serial
# header: `autoupdate` -- the SD-card reflash that is the only way back into
# this board -- lives inside bootcmd today, so a bootcmd that fails to parse
# takes the recovery path down with it and the next stop is a SPI clip.
# Putting `run autoupdate` in preboot as well makes recovery independent of
# bootcmd, which is what allows bootcmd to be edited at all.
CONFIG_USE_PREBOOT=y

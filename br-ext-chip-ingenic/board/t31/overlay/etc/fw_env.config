# U-Boot environment location on the T31.
#
# openipc-firmware ships no fw_env.config of its own, but a great deal of this
# tree assumes one exists: /etc/profile and rcS read `sensor` and `upgrade`,
# S40network reads `wlandev`, `wlanmac`, `netaddr_fallback` and `ethaddr`, and
# rcd shells out to fw_printenv for the interface probe and fw_setenv for the
# wifi credentials. Without this file every one of those reads returns empty,
# which on a board whose only interface is the radio means no network at all --
# and it fails quietly, looking like a provider bug rather than a missing file.
#
#   dev:    size      erasesize  name
#   mtd0: 00050000  00008000  "boot"
#   mtd1: 00010000  00008000  "env"      <- this file
#   mtd2: 00010000  00008000  "backup"
#   mtd3: 00200000  00008000  "kernel"
#   mtd4: 00800000  00008000  "rootfs"
#   mtd5: 00590000  00008000  "rootfs_data"
#   mtd6: 01000000  00008000  "all"
#
# Offset and size follow CONFIG_ENV_OFFSET=0x50000 and CONFIG_ENV_SIZE=0x10000,
# which are compiled into the bootloader; see
# br-ext-chip-ingenic/board/t31/wyze-v3.env.txt.
#
# The 0x8000 sector is the Ingenic jz_sfc erase granularity, not a copy of the
# environment size. fw_setenv erases one sector at a time and MEMERASE rejects
# an unaligned length, so a wrong value here turns every write into a failure
# on a path -- credentials, sysupgrade -- that has to work unattended.
#
# <device> <offset> <env size> <sector size>
/dev/mtd1 0x0 0x10000 0x8000

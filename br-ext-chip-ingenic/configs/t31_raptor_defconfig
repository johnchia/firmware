# Architecture
BR2_mipsel=y
BR2_mips_xburst=y
# BR2_MIPS_SOFT_FLOAT is not set
BR2_MIPS_FP32_MODE_32=y

# Toolchain
#
# uClibc-ng, built here, rather than the prebuilt musl external toolchain the
# rest of this vendor directory uses. The C library is not a preference on this
# target -- it is the ABI the vendor libraries were compiled against, and they
# are the whole reason the board is interesting.
#
# libimp.so, libalog.so and libsysutils.so carry no DT_NEEDED at all: every libc
# entry point they use is left undefined for the global scope to satisfy, and
# they were built against uClibc. `nm -D --undefined-only libimp.so` names
# __assert, not __assert_fail, which is what says so. Three kinds of gap follow
# from running them on musl, and only the first is a matter of missing symbols:
#
#   1. __assert, __fgetc_unlocked, __pthread_register_cancel,
#      __pthread_unregister_cancel and __pthread_unwind_next do not exist in
#      musl. A static shim linked --whole-archive --export-dynamic into every
#      executable that loads libimp is enough for these, and is as far as a
#      shim can get.
#   2. mmap, lseek and readdir have the same names in both libraries and
#      different ABIs. musl's off_t is 64-bit everywhere, so mmap's sixth
#      argument -- on the stack, in o32 -- is eight bytes where the vendor
#      library pushes four, and lseek's third argument moves. A shim can only
#      fix these by displacing musl's own implementations inside the
#      executable, for every caller, not just the vendor library's.
#   3. stat differs in struct layout, and cannot be fixed by a definition at
#      all without knowing which of the two layouts the caller meant.
#
# uClibc-ng removes all three by construction: enabling LFS gives it mmap64 and
# lseek64 as separate entry points and leaves the base names 32-bit, which is
# exactly the shape the vendor library was compiled for. The shim is then not
# needed, and neither is the class of bug it exists to paper over.
#
# The internal backend, not a prebuilt uClibc release, so the libc that the
# image runs is the one this tree configured: NPTL rather than linuxthreads,
# which the vendor libraries' __pthread_* imports require. t31glibc_lite is the
# in-tree precedent for building an Ingenic toolchain here, and thingino's
# xburst1 uClibc toolchain -- gcc, headers 3.10, WCHAR and LOCALE on -- is the
# working reference for this exact SoC.
BR2_TOOLCHAIN_BUILDROOT_VENDOR="openipc"
BR2_TOOLCHAIN_BUILDROOT_UCLIBC=y
BR2_KERNEL_HEADERS_VERSION=y
BR2_DEFAULT_KERNEL_VERSION="3.10.14"
BR2_PACKAGE_HOST_LINUX_HEADERS_CUSTOM_3_10=y
BR2_GCC_VERSION_13_X=y
BR2_PTHREADS_NATIVE=y
BR2_TOOLCHAIN_BUILDROOT_WCHAR=y
BR2_TOOLCHAIN_BUILDROOT_LOCALE=y
BR2_TOOLCHAIN_BUILDROOT_CXX=y
# Not optional, and not a preference. general/openipc.fragment sets
# BR2_SSP_REGULAR for every board, and that option depends on
# BR2_TOOLCHAIN_HAS_SSP -- which musl selects unconditionally and uClibc
# selects only from here. Without this line kconfig drops BR2_SSP_REGULAR
# without a word and the image is built with no stack protector at all.
BR2_TOOLCHAIN_BUILDROOT_USE_SSP=y
# uClibc's own ldd, which musl provided as a symlink to the loader. Worth the
# few kilobytes on the first target here that runs vendor blobs it did not
# link: "which libc symbol is missing" is the question this board asks.
BR2_UCLIBC_INSTALL_UTILS=y

# Kernel
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_TARBALL=y
# PINNED, NOT TRACKED. The URL names a commit; it used to name the branch, and
# a branch name means one filename forever. Buildroot caches a download by
# filename and does not re-fetch, so a tree that had built this board kept
# building whatever it fetched first -- with nothing anywhere able to say which
# commit that was. A commit in the URL makes the filename change when the source
# does, and makes the tarball sitting in dl/linux/ answer the question.
#
# The branch is still where new work lands. Bumping this line is the deliberate
# act that brings it here, and this says what it has moved to since:
#   git ls-remote https://github.com/openipc/linux refs/heads/ingenic-t31
BR2_LINUX_KERNEL_CUSTOM_TARBALL_LOCATION="https://github.com/openipc/linux/archive/55ab8a5c50e6088c4fd1136485357b912f954144.tar.gz"
BR2_LINUX_KERNEL_USE_CUSTOM_CONFIG=y
BR2_LINUX_KERNEL_CUSTOM_CONFIG_FILE="$(EXTERNAL_VENDOR)/board/$(OPENIPC_SOC_FAMILY)/t31.generic.config"
BR2_LINUX_KERNEL_LZMA=y

# Filesystem
BR2_PACKAGE_BUSYBOX_CONFIG="$(BR2_EXTERNAL)/package/busybox/busybox.config"
# fw_printenv/fw_setenv. Not optional here: S40network reads wlandev, wlanssid
# and wlanpass out of the U-Boot environment to bring the radio up, and rcd
# asks the same question to decide which interface the camera has. A build
# without these is a camera with no network on a board with no Ethernet.
BR2_PACKAGE_UBOOT_TOOLS=y
# BR2_PACKAGE_IFUPDOWN_SCRIPTS is not set
BR2_TARGET_ROOTFS_CPIO=y
BR2_TARGET_ROOTFS_SQUASHFS=y
BR2_TARGET_ROOTFS_SQUASHFS4_XZ=y
# Fail the build, not the flash, when the rootfs outgrows its partition. The
# limit is BR2_OPENIPC_ROOTFS_PART_KB below.
BR2_ROOTFS_POST_IMAGE_SCRIPT="$(BR2_EXTERNAL)/scripts/check-rootfs-size.sh"

# OpenIPC
BR2_OPENIPC_SOC_VENDOR="ingenic"
BR2_OPENIPC_SOC_MODEL="t31"
BR2_OPENIPC_SOC_FAMILY="t31"
BR2_OPENIPC_VARIANT="raptor"
# The Wyze Cam v3 this targets has 16MB of NOR. The partition table is the
# bootloader's, not this build's -- see PLAN-captive-portal.md -- and the
# rootfs slot in it is 8192KB, which is what the image has to fit.
BR2_OPENIPC_FLASH_SIZE="16"
BR2_OPENIPC_ROOTFS_PART_KB="8192"
# One sensor per target, as everywhere else: the GC2053 the Wyze v3 carries.
# raptor probes the sensor at runtime regardless, so a board with a different
# part still streams -- it falls back to generic tuning and the colour is
# wrong, which is the cost every other single-sensor target already carries.
BR2_OPENIPC_SNS_MODEL="gc2053"

# Packages
#
# Raptor owns the camera on this image, and here it is the only thing that can:
# no majestic. The other raptor targets carry it defused as the reference
# encoder to cross-check against, but OpenIPC publishes one prebuilt majestic
# per SoC family and it is linked against musl -- ELF interpreter
# /lib/ld-musl-mipsel.so.1, DT_NEEDED libc.so -- so on a uClibc rootfs it does
# not load at all. Carrying two megabytes of an eight-megabyte rootfs for a
# binary that cannot start is worse than not having the cross-check.
BR2_PACKAGE_DROPBEAR_OPENIPC=y
BR2_PACKAGE_INGENIC_OSDRV_T31=y
BR2_PACKAGE_IPCTOOL=y
BR2_PACKAGE_JSONFILTER=y
BR2_PACKAGE_LIBCURL_OPENIPC=y
BR2_PACKAGE_LIBCURL_OPENIPC_CURL=y
# BR2_PACKAGE_LIBCURL_OPENIPC_PROXY_SUPPORT is not set
# BR2_PACKAGE_LIBCURL_OPENIPC_COOKIES_SUPPORT is not set
# BR2_PACKAGE_LIBCURL_OPENIPC_EXTRA_PROTOCOLS_FEATURES is not set
BR2_PACKAGE_LIBEVENT_OPENIPC=y
BR2_PACKAGE_LIBOGG_OPENIPC=y
BR2_PACKAGE_MBEDTLS_OPENIPC=y
# mDNS-SD, so the camera answers to <hostname>.local. On a wireless camera with
# no Ethernet and a DHCP address, being findable by name is not a convenience.
BR2_PACKAGE_MDNSD_OPENIPC=y
# The client library only; rmq publishes to a broker elsewhere.
BR2_PACKAGE_MOSQUITTO=y
# BR2_PACKAGE_MOSQUITTO_BROKER is not set
BR2_PACKAGE_OPUS_OPENIPC=y
BR2_PACKAGE_OPUS_OPENIPC_FIXED_POINT=y
BR2_PACKAGE_RAPTOR_STREAMING=y
BR2_PACKAGE_YAML_CLI=y

# Wireless. The AltoBeam ATBM6031 over SDIO is the only network interface this
# board has: the Wyze v3 has no Ethernet PHY. `wlandev=atbm603x-t31-wyze-v3`
# in the U-Boot environment is what selects the bring-up sequence in
# /etc/wireless/sdio, and wlanssid/wlanpass are the credentials.
BR2_PACKAGE_ATBM60XX=y
BR2_PACKAGE_ATBM60XX_MODEL_603X=y
BR2_PACKAGE_ATBM60XX_INTERFACE_SDIO=y
BR2_PACKAGE_WIRELESS_TOOLS=y
BR2_PACKAGE_WPA_SUPPLICANT=y
BR2_PACKAGE_WPA_SUPPLICANT_CLI=y
BR2_PACKAGE_WPA_SUPPLICANT_PASSPHRASE=y
# Setup mode raises an access point of its own, and this is what lets the
# supplicant be one: `mode=2` in a network block is rejected without it. No
# hostapd -- the ATBM driver advertises NL80211_IFTYPE_AP and leaves the AP
# state machine in userspace, so one supplicant binary serves both modes and
# the camera carries one less daemon it uses for a few minutes of its life.
BR2_PACKAGE_WPA_SUPPLICANT_AP_SUPPORT=y

# Bootloader.
#
# Built from source, pinned to the commit whose build is on the bench board:
# gtxaspec/u-boot ingenic-t-series, mainline U-Boot with the Ingenic T-series
# port. The 2013.07 ISVP tree (openipc/u-boot-ingenic) is the other Ingenic
# lineage and is NOT interchangeable -- it has no fatwrite, no DM/DT MMC and
# no button-at-boot, so it cannot run the SD-card recovery path this board
# depends on. Pin a commit, never the branch: the bootloader is the one thing
# on this camera that cannot be fixed from a shell.
BR2_TARGET_UBOOT=y
BR2_TARGET_UBOOT_BUILD_SYSTEM_KCONFIG=y
BR2_TARGET_UBOOT_CUSTOM_GIT=y
BR2_TARGET_UBOOT_CUSTOM_REPO_URL="https://github.com/gtxaspec/u-boot.git"
BR2_TARGET_UBOOT_CUSTOM_REPO_VERSION="83982542774ce53a41d60c85e835aa9c4b746388"
BR2_TARGET_UBOOT_BOARD_DEFCONFIG="isvp_t31x_sfcnor"
BR2_TARGET_UBOOT_FORMAT_CUSTOM=y
# T31 does its DDR bring-up in the TPL, not the SPL, so the bootable
# container is u-boot-with-tpl-lzma.bin. u-boot.bin alone is the payload
# without the loader in front of it and does not boot.
BR2_TARGET_UBOOT_FORMAT_CUSTOM_NAME="u-boot-with-tpl-lzma.bin"
BR2_TARGET_UBOOT_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL)/../br-ext-chip-ingenic/board/t31/uboot.config"
BR2_TARGET_UBOOT_NEEDS_DTC=y
BR2_TARGET_UBOOT_NEEDS_PYTHON3=y
BR2_TARGET_UBOOT_NEEDS_PYLIBFDT=y
BR2_TARGET_UBOOT_NEEDS_PYELFTOOLS=y

# Per-board device tree: SD slot power (48, active low), card detect (59) and
# the reset button (51). Without the first two the bootloader cannot read the
# card, and the recovery path is decorative.
BR2_PACKAGE_INGENIC_UBOOT=y
BR2_PACKAGE_INGENIC_UBOOT_GPIO_MMC_CD="59"
BR2_PACKAGE_INGENIC_UBOOT_GPIO_MMC_POWER="48"
BR2_PACKAGE_INGENIC_UBOOT_GPIO_MMC_POWER_ACTIVE_LOW=y
BR2_PACKAGE_INGENIC_UBOOT_GPIO_BUTTON_RESET="51"

# The environment is data in mtd1, not compiled into U-Boot, so the layout and
# the recovery verbs live in a text file and are readable back off the chip.
BR2_PACKAGE_HOST_UBOOT_TOOLS=y
BR2_PACKAGE_HOST_UBOOT_TOOLS_ENVIMAGE=y
BR2_PACKAGE_HOST_UBOOT_TOOLS_ENVIMAGE_SOURCE="$(BR2_EXTERNAL)/../br-ext-chip-ingenic/board/t31/wyze-v3.env.txt"
BR2_PACKAGE_HOST_UBOOT_TOOLS_ENVIMAGE_SIZE="0x10000"

# fw_env.config is board-specific and the shared overlay has none, so this
# board appends its own. Buildroot applies overlays in order, so anything here
# wins over general/overlay with no merge surface upstream.
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL)/overlay $(BR2_EXTERNAL)/../br-ext-chip-ingenic/board/t31/overlay"

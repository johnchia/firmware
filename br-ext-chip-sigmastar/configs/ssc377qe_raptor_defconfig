# Architecture
BR2_arm=y
BR2_cortex_a35=y
BR2_ARM_FPU_NEON_VFPV4=y
BR2_ARM_INSTRUCTIONS_THUMB2=y

# Toolchain
BR2_TOOLCHAIN_EXTERNAL=y
BR2_TOOLCHAIN_EXTERNAL_CUSTOM=y
BR2_TOOLCHAIN_EXTERNAL_DOWNLOAD=y
# Mirrored, not tracked. This is a byte-for-byte copy of the toolchain OpenIPC
# publishes -- nothing rebuilt, so it is the compiler every hardware
# verification on this board was done with -- taken 2026-08-28 and given a name
# that carries the date.
#
# Upstream keeps all of them on one `toolchain` tag and overwrites the assets in
# place: published 2025-02-24, last rewritten 2026-05-29. Buildroot caches a
# download by filename, so toolchain.<family>.tgz named one file forever while
# the bytes behind it were free to change, on a tag nothing prevents from being
# rewritten again. A dated name makes a new upload a new filename, which a stale
# download cache cannot answer for.
#
# sha256 of all three is in the release notes. OPENIPC_KERNEL is <vendor>-<family>
# -- the toolchain is per family, and this is the same string OPENIPC_TOOLCHAIN
# was built from.
BR2_TOOLCHAIN_EXTERNAL_URL="https://github.com/johnchia/firmware/releases/download/toolchain-2026-08-28/toolchain.$(OPENIPC_KERNEL)-20260828.tgz"
BR2_TOOLCHAIN_EXTERNAL_CUSTOM_PREFIX="arm-openipc-linux-musleabihf"
BR2_TOOLCHAIN_EXTERNAL_HEADERS_5_10=y
BR2_TOOLCHAIN_EXTERNAL_CUSTOM_MUSL=y
BR2_TOOLCHAIN_EXTERNAL_CXX=y

# Kernel
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_TARBALL=y
# The kernel from a fork of openipc/linux, on a branch of the same name.
#
# It carries /proc/flash_uid: the NOR part's factory unique ID, which on
# this SoC is the only per-unit identity there is, the die ID registers reading
# zero. rcS derives a MAC address from it, so that every camera built from this
# image does not answer to 00:00:23:34:45:66.
#
# PINNED, NOT TRACKED. The URL names a commit; it used to name the branch, and
# a branch name means one filename forever. Buildroot caches a download by
# filename and does not re-fetch, so a tree that had built this board kept
# building whatever it fetched first -- with nothing anywhere able to say which
# commit that was. A commit in the URL makes the filename change when the source
# does, and makes the tarball sitting in dl/linux/ answer the question.
#
# The branch is still where new work lands. Bumping this line is the deliberate
# act that brings it here, and this says what it has moved to since:
#   git ls-remote https://github.com/johnchia/linux refs/heads/sigmastar-infinity6c
#
# The pin is the amended commit, and the distinction is not academic. The
# version an unpinned tree here had cached clamped the RDUID read and returned
# 114a3f3b09910000 -- six bytes of the ID and two zeros -- which folds into a
# different MAC than the 114a3f3b09914824 the board was verified on. Both
# answered to the name "sigmastar-infinity6c".
BR2_LINUX_KERNEL_CUSTOM_TARBALL_LOCATION="https://github.com/johnchia/linux/archive/83a9f82c5716031ddfa51bf838e9f8fb93605c7a.tar.gz"
BR2_LINUX_KERNEL_USE_CUSTOM_CONFIG=y
BR2_LINUX_KERNEL_CUSTOM_CONFIG_FILE="$(EXTERNAL_VENDOR)/board/$(OPENIPC_SOC_FAMILY)/infinity6c-ssc027d.config"
BR2_LINUX_KERNEL_UIMAGE=y
BR2_LINUX_KERNEL_XZ=y

# Filesystem
BR2_PACKAGE_BUSYBOX_CONFIG="$(BR2_EXTERNAL)/package/busybox/busybox.config"
BR2_PACKAGE_EXFATPROGS=y
BR2_PACKAGE_UBOOT_TOOLS=y
BR2_PACKAGE_WIREGUARD_TOOLS=y
BR2_PACKAGE_ZLIB=y
# BR2_PACKAGE_IFUPDOWN_SCRIPTS is not set
BR2_TARGET_ROOTFS_SQUASHFS=y
BR2_TARGET_ROOTFS_SQUASHFS4_XZ=y
# Fail the build, not the flash, when the rootfs outgrows its partition. The
# limit is BR2_OPENIPC_ROOTFS_PART_KB below.
BR2_ROOTFS_POST_IMAGE_SCRIPT="$(BR2_EXTERNAL)/scripts/check-rootfs-size.sh"

# OpenIPC
BR2_OPENIPC_SOC_VENDOR="sigmastar"
BR2_OPENIPC_SOC_MODEL="ssc377qe"
BR2_OPENIPC_SOC_FAMILY="infinity6c"
BR2_OPENIPC_VARIANT="raptor"
BR2_OPENIPC_FLASH_SIZE="16"
# The rootfs partition, stated because it does not follow from the chip size
# even now that the chip size is right. u-boot picks between two layouts at
# boot and reconfigures to the larger one once the rootfs outgrows 5120KB; the
# layout this board runs gives the rootfs 8MB, as the kernel reports it:
#
#   mtd2 kernel      offset 0x00050000  size 0x00200000  (2048 KB)
#   mtd3 rootfs      offset 0x00250000  size 0x00800000  (8192 KB)
#   mtd4 rootfs_data offset 0x00a50000  size 0x005b0000  (5824 KB)
#
# summing to exactly 0x1000000. This was "8" with no partition size, which
# capped the build at 5120KB -- 3MB below the partition, so the build refused
# images the board would have taken, and the rootfs sat at 5120/5120 with the
# slack unreachable.
BR2_OPENIPC_ROOTFS_PART_KB="8192"

# Packages
#
# Raptor owns the camera on this image: nothing else streams from it, so the
# OSDRV package installs the full Infinity6C vendor library bundle on its own
# and the HAL dlopens what it needs from there.
#
# Majestic is carried anyway, as a reference encoder rather than a streamer. It
# is the second opinion when the MI stack refuses something and it is not clear
# whether the fault is Raptor's or the SoC's -- the H.265 rate-control question
# on this part is exactly that shape. It does not start on its own: a post-build
# hook renames its init script to K95majestic (see
# general/scripts/late-post-build-hooks.list), because /etc/init.d runs in name
# order and S95majestic would otherwise take the MI devices before S95raptor.
# To use it: /etc/init.d/S95raptor stop, then run majestic by hand.
#
# Raptor is fetched from four pinned commits on github.com/johnchia (the
# sigmastar branches are not upstream yet), so this target builds with no
# checkout. To build one instead:
#
#   make BOARD=ssc377qe_raptor RAPTOR_SRCDIR=/path/to/raptor-parent
#
# libschrift (the glyph rasteriser) and majestic-fonts (the TrueType file it
# loads) are pulled in by the Raptor package rather than listed here.
BR2_PACKAGE_DROPBEAR_OPENIPC=y
BR2_PACKAGE_EXFAT_OPENIPC=y
BR2_PACKAGE_IPCTOOL=y
BR2_PACKAGE_JSONFILTER=y
BR2_PACKAGE_LIBCURL_OPENIPC=y
BR2_PACKAGE_LIBCURL_OPENIPC_CURL=y
# BR2_PACKAGE_LIBCURL_OPENIPC_PROXY_SUPPORT is not set
# BR2_PACKAGE_LIBCURL_OPENIPC_COOKIES_SUPPORT is not set
# BR2_PACKAGE_LIBCURL_OPENIPC_EXTRA_PROTOCOLS_FEATURES is not set
BR2_PACKAGE_MAJESTIC=y
# mDNS-SD, so the camera answers to <hostname>.local and its services can be
# found without knowing the address. It pairs with the per-MAC hostname derived
# in rcS: that is what makes the name unique across cameras on the same SoC,
# and this is what publishes it. Services are files in /etc/mdns.d.
#
# mquery (the LAN scanner) is deliberately left out. It is a diagnostic, this
# rootfs has about 20 KB of slack, and browsing from a host answers the same
# question without spending any of it.
BR2_PACKAGE_MDNSD_OPENIPC=y
BR2_PACKAGE_MBEDTLS_OPENIPC=y
# The client library only. The broker is a forking server with no role on a
# camera that publishes to one elsewhere, and Buildroot ties mosquitto's TLS to
# OpenSSL, which this image does not carry -- mbedTLS is its TLS -- so
# libmosquitto here speaks plain MQTT.
BR2_PACKAGE_MOSQUITTO=y
# BR2_PACKAGE_MOSQUITTO_BROKER is not set
BR2_PACKAGE_RAPTOR_STREAMING=y
BR2_PACKAGE_SIGMASTAR_OSDRV_INFINITY6C=y
# The bootloader, built here rather than downloaded. It is upstream's, unmodified
# but for a packaging patch: the MAC derivation that used to justify a fork now
# lives in rootfs, where rcS folds /proc/flash_uid into an address. What building
# it locally buys is that a bootloader change can reach an image at all -- both
# paths that assemble a full .bin otherwise fetch u-boot from the release server.
# It is not in the sysupgrade tarball; it lands in images/ as
# u-boot-ssc377qe-nor.bin for `make fullimage`, because mtd0 has no software
# recovery and writing it is a deliberate act.
BR2_TARGET_UBOOT=y
BR2_TARGET_UBOOT_BUILD_SYSTEM_KCONFIG=y
BR2_TARGET_UBOOT_CUSTOM_TARBALL=y
# Pinned by commit, like the kernel and the toolchain above. The branch is
# openipc/u-boot-sigmastar master and this is where it stood; bumping the line is
# the deliberate act that moves it, and the hash in all-patches/uboot/uboot.hash
# says which bytes that commit must arrive as.
BR2_TARGET_UBOOT_CUSTOM_TARBALL_LOCATION="https://github.com/openipc/u-boot-sigmastar/archive/bf77aff5d44f34d14b89b3f4014aa8dda9834794.tar.gz"
# One defconfig per family; the SoC model reaches the code as -DPRODUCT_SOC,
# which sigmastar-boot passes. The vendor's own arrangement, from build.sh.
#
# Spelled out rather than written as $(OPENIPC_SOC_FAMILY), which does not work
# here and fails in a way worth knowing about. uboot.mk refuses an empty board
# defconfig with $(error) at parse time -- boot/common.mk, buildroot/Makefile
# line 532 -- and this tree's OPENIPC_* variables are not defined until
# external.mk is included thirteen lines later. The expansion is empty exactly
# at the moment it is checked, so the build dies claiming nothing was specified.
# (The kernel's $(EXTERNAL_VENDOR) paths are fine: those are read in recipes,
# not at parse time.) sigmastar-boot asserts the two agree before building.
BR2_TARGET_UBOOT_BOARD_DEFCONFIG="infinity6c"
# The container make_boot_spinor.sh assembles, not u-boot.bin. Naming it here is
# what makes a build that produced no container fail rather than quietly install
# nothing; sigmastar-boot then renames it to u-boot-<soc>-nor.bin.
BR2_TARGET_UBOOT_FORMAT_CUSTOM=y
BR2_TARGET_UBOOT_FORMAT_CUSTOM_NAME="BOOT.bin"
# Not the global patch dir. t31_raptor builds a different U-Boot through the
# same Buildroot package, and all-patches/uboot/ would reach it too.
BR2_TARGET_UBOOT_PATCH="$(BR2_EXTERNAL)/package/sigmastar-boot/patches"
BR2_PACKAGE_SIGMASTAR_BOOT=y
BR2_PACKAGE_VTUND_OPENIPC=y

# Architecture
BR2_arm=y
BR2_cortex_a7=y
BR2_ARM_FPU_NEON_VFPV4=y
BR2_ARM_INSTRUCTIONS_THUMB2=y

# Toolchain
BR2_TOOLCHAIN_EXTERNAL=y
BR2_TOOLCHAIN_EXTERNAL_CUSTOM=y
BR2_TOOLCHAIN_EXTERNAL_DOWNLOAD=y
# Mirrored, not tracked. This is a byte-for-byte copy of the toolchain OpenIPC
# publishes -- nothing rebuilt, so it is the compiler every hardware
# verification on this board was done with -- taken 2026-08-28 and given a name
# that carries the date.
#
# Upstream keeps all of them on one `toolchain` tag and overwrites the assets in
# place: published 2025-02-24, last rewritten 2026-05-29. Buildroot caches a
# download by filename, so toolchain.<family>.tgz named one file forever while
# the bytes behind it were free to change, on a tag nothing prevents from being
# rewritten again. A dated name makes a new upload a new filename, which a stale
# download cache cannot answer for.
#
# sha256 of all three is in the release notes. OPENIPC_KERNEL is <vendor>-<family>
# -- the toolchain is per family, and this is the same string OPENIPC_TOOLCHAIN
# was built from.
BR2_TOOLCHAIN_EXTERNAL_URL="https://github.com/johnchia/firmware/releases/download/toolchain-2026-08-28/toolchain.$(OPENIPC_KERNEL)-20260828.tgz"
BR2_TOOLCHAIN_EXTERNAL_CUSTOM_PREFIX="arm-openipc-linux-gnueabihf"
BR2_TOOLCHAIN_EXTERNAL_HEADERS_4_9=y
BR2_TOOLCHAIN_EXTERNAL_CUSTOM_GLIBC=y
# BR2_TOOLCHAIN_EXTERNAL_INET_RPC is not set
BR2_TOOLCHAIN_EXTERNAL_CXX=y

# Kernel
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_TARBALL=y
# The kernel from a fork of openipc/linux, on a branch of the same name.
#
# It carries /proc/flash_uid: the NOR part's factory unique ID, which is
# the one per-unit value these boards have, published so that rcS can derive a
# MAC address from it. Without it every camera built from this image answers to
# 00:00:23:34:45:66.
#
# PINNED, NOT TRACKED. The URL names a commit; it used to name the branch, and
# a branch name means one filename forever. Buildroot caches a download by
# filename and does not re-fetch, so a tree that had built this board kept
# building whatever it fetched first -- with nothing anywhere able to say which
# commit that was. A commit in the URL makes the filename change when the source
# does, and makes the tarball sitting in dl/linux/ answer the question.
#
# The branch is still where new work lands. Bumping this line is the deliberate
# act that brings it here, and this says what it has moved to since:
#   git ls-remote https://github.com/johnchia/linux refs/heads/sigmastar-infinity6e
BR2_LINUX_KERNEL_CUSTOM_TARBALL_LOCATION="https://github.com/johnchia/linux/archive/074933050d6a42d96297c27205b357726ae80260.tar.gz"
BR2_LINUX_KERNEL_USE_CUSTOM_CONFIG=y
BR2_LINUX_KERNEL_CUSTOM_CONFIG_FILE="$(EXTERNAL_VENDOR)/board/$(OPENIPC_SOC_FAMILY)/infinity6e-ssc012b.config"
BR2_LINUX_KERNEL_UIMAGE=y
BR2_LINUX_KERNEL_XZ=y

# Filesystem
BR2_PACKAGE_BUSYBOX_CONFIG="$(BR2_EXTERNAL)/package/busybox/busybox.config"
BR2_PACKAGE_EXFATPROGS=y
BR2_PACKAGE_UBOOT_TOOLS=y
BR2_PACKAGE_WIREGUARD_LINUX_COMPAT=y
BR2_PACKAGE_WIREGUARD_TOOLS=y
BR2_PACKAGE_ZLIB=y
# BR2_PACKAGE_IFUPDOWN_SCRIPTS is not set
BR2_TARGET_ROOTFS_SQUASHFS=y
BR2_TARGET_ROOTFS_SQUASHFS4_XZ=y
# Fail the build, not the flash, when the rootfs outgrows its partition. The
# limit is BR2_OPENIPC_ROOTFS_PART_KB below.
BR2_ROOTFS_POST_IMAGE_SCRIPT="$(BR2_EXTERNAL)/scripts/check-rootfs-size.sh"

# OpenIPC
BR2_OPENIPC_SOC_VENDOR="sigmastar"
BR2_OPENIPC_SOC_MODEL="ssc30kq"
BR2_OPENIPC_SOC_FAMILY="infinity6e"
BR2_OPENIPC_VARIANT="raptor"
BR2_OPENIPC_FLASH_SIZE="16"
# A CEILING, NOT A LAYOUT
#
# This is the largest rootfs the build may emit. It does not choose a partition
# table and cannot: U-Boot does that at boot, reading the squashfs superblock at
# 0x250000 and taking 8192k once bytes_used + 0x1000 reaches 0x500000, 5120k
# below that (common/cmd_sf.c). So the layout follows the size of the image
# actually flashed --
#
#   under ~5116KB   0x250000-0x750000 rootfs 5120KB, rootfs_data 8896KB
#   at or over      0x250000-0xa50000 rootfs 8192KB, rootfs_data 5824KB
#
# -- and this setting only says which of the two the build is allowed to reach.
# At 4844KB the current build sits in the first, and `make fullimage` says so:
# "rootfs partition 5120k, which is what U-Boot will pick".
#
# It was "5120", which capped the build 3MB below what the board can hold. 8192
# is the real ceiling, but IT IS ONLY SAFE WITH THE BOOTLOADER BELOW. The
# switch is this fork's, so a board running anything else keeps the compiled-in
# 5120k however large the rootfs is -- and a rootfs built past 5120KB then runs
# into rootfs_data. Not a brick, just every setting on the camera gone with
# nothing saying why. `make fullimage` writes both together and computes the
# layout with U-Boot's own rule, which is why it is the way to flash this.
#
# Do not raise it past 8192. That is what U-Boot's larger branch hands out and
# nothing here can widen it, whatever the chip has spare.
BR2_OPENIPC_ROOTFS_PART_KB="8192"

# Packages
#
# Raptor owns the camera on this image: there is no Majestic and no Divinus, so
# the OSDRV package installs the full Infinity6E vendor library bundle on its
# own (see its BR2_PACKAGE_MAJESTIC condition) and the HAL dlopens what it needs
# from there.
#
# Raptor is fetched from pinned commits on github.com/johnchia (the sigmastar
# branches are not upstream yet), so this target builds with no checkout. To
# build one instead:
#
#   make BOARD=ssc30kq_raptor RAPTOR_SRCDIR=/path/to/raptor-parent
#
# THE SHIPPED raptor.conf CARRIES NO BOARD SETTINGS
#
# Raptor used to carry a raptor-ssc30kq.conf and the package preferred it over
# the generic file. That fork is gone: every image now installs raptor.conf, and
# general/overlay/etc/raptor.conf is what an image changes, which is global
# rather than per-board.
#
# The IR-cut GPIOs went with it. Those were never an SSC30KQ property in the
# first place -- they are board wiring, and two cameras on this part from
# different vendors have no reason to agree -- so a defconfig, which is keyed on
# the SoC model, is the wrong place to state them and this one does not.
# Nothing rediscovers them either: /etc/thingino.json is a thingino file and
# does not exist here, so unset pins mean a filter that never moves.
#
# Set them per camera in the overlay before trusting day/night. raptor's
# docs/sigmastar.md has the pins the bring-up unit used as a worked example,
# plus the H-bridge polarity trap and the night_gain reasoning.
#
# libschrift (rod's glyph rasteriser) and majestic-fonts (the TrueType file it
# loads) are pulled in by the Raptor package rather than listed here.
BR2_PACKAGE_DROPBEAR_OPENIPC=y
BR2_PACKAGE_EXFAT_OPENIPC=y
BR2_PACKAGE_IPCTOOL=y
BR2_PACKAGE_JSONFILTER=y
BR2_PACKAGE_LIBCURL_OPENIPC=y
BR2_PACKAGE_LIBCURL_OPENIPC_CURL=y
# BR2_PACKAGE_LIBCURL_OPENIPC_PROXY_SUPPORT is not set
# BR2_PACKAGE_LIBCURL_OPENIPC_COOKIES_SUPPORT is not set
# BR2_PACKAGE_LIBCURL_OPENIPC_EXTRA_PROTOCOLS_FEATURES is not set
BR2_PACKAGE_MBEDTLS_OPENIPC=y
# mDNS-SD, so the camera answers to <hostname>.local and its services can be
# found without knowing the address. It pairs with the per-MAC hostname derived
# in rcS: that is what makes the name unique across cameras on the same SoC,
# and this is what publishes it. Services are files in /etc/mdns.d.
#
# It is also how rmq finds the MQTT broker with no [mqtt] host configured, and
# that half is a BUILD-TIME dependency: raptor's Makefile looks for libmdnsd in
# the sysroot and compiles rmq's discovery to stubs when it is absent. Without
# this line the camera does not fail to find a broker, it never looks -- so a
# board that reaches its broker perfectly well sits on 127.0.0.1 refusing
# connections. Leaving mdnsd out is a decision to configure every broker
# address by hand.
BR2_PACKAGE_MDNSD_OPENIPC=y
# The client library only. rmq links libmosquitto, so the Raptor package depends
# on mosquitto unconditionally and it is built for this target whether or not it
# is selected here; selecting it is what makes the broker's `default y` visible
# so it can be turned off. Left implicit, the broker is excluded only because the
# symbol above happens to be unset, which is not a decision anyone made.
BR2_PACKAGE_MOSQUITTO=y
# BR2_PACKAGE_MOSQUITTO_BROKER is not set
BR2_PACKAGE_RAPTOR_STREAMING=y
BR2_PACKAGE_SIGMASTAR_OSDRV_INFINITY6E=y
# The bootloader, built here rather than downloaded, because the two-layout
# rootfs rule above lives in this fork's common/cmd_sf.c and a board running
# anything else keeps rootmtd at 5120k.
#
# infinity6e_defconfig exists in the tree and takes the same NOR branch of
# sstar-common.h as infinity6c -- same 0x250000 rootfs, same ${rootmtd} in
# bootargs -- so the rule applies unchanged. It is not in the sysupgrade
# tarball: it lands in images/ as u-boot-ssc30kq-nor.bin for `make fullimage`,
# because mtd0 has no software recovery and writing it is a deliberate act.
#
# It buys the MAC too, as of u-boot c531802. Before that the derivation was in
# infinity6c/chip.c with nothing calling it on 6E, and this board answered to
# the shared 00:00:23:34:45:66 like every other; it is shared code now and both
# parts derive an address from the NOR unique ID. Not from 6E's own die ID,
# which does work (48 bits of OTP at 0x1F203150, where the 6C registers read
# zero) -- one derivation for both parts beats two that each cover one.
#
# Getting there meant turning on CONFIG_MS_NOR_ONEBIN and CONFIG_MS_MTD_ISP_FLASH
# in U-Boot's own infinity6e_defconfig -- that is where the change lives, not
# here -- which swaps 6E onto the flash driver 6C has always used. Worth knowing
# if this board misbehaves around flash rather than around MAC addresses.
BR2_PACKAGE_SIGMASTAR_UBOOT=y
BR2_PACKAGE_VTUND_OPENIPC=y

# Architecture
BR2_arm=y
BR2_cortex_a7=y
BR2_ARM_FPU_NEON_VFPV4=y
BR2_ARM_INSTRUCTIONS_THUMB2=y

# Toolchain
BR2_TOOLCHAIN_EXTERNAL=y
BR2_TOOLCHAIN_EXTERNAL_CUSTOM=y
BR2_TOOLCHAIN_EXTERNAL_DOWNLOAD=y
BR2_TOOLCHAIN_EXTERNAL_URL="https://github.com/openipc/firmware/releases/download/$(OPENIPC_TOOLCHAIN).tgz"
BR2_TOOLCHAIN_EXTERNAL_CUSTOM_PREFIX="arm-openipc-linux-gnueabihf"
BR2_TOOLCHAIN_EXTERNAL_HEADERS_4_9=y
BR2_TOOLCHAIN_EXTERNAL_CUSTOM_GLIBC=y
# BR2_TOOLCHAIN_EXTERNAL_INET_RPC is not set
BR2_TOOLCHAIN_EXTERNAL_CXX=y

# Kernel
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_TARBALL=y
BR2_LINUX_KERNEL_CUSTOM_TARBALL_LOCATION="https://github.com/openipc/linux/archive/$(OPENIPC_KERNEL).tar.gz"
BR2_LINUX_KERNEL_USE_CUSTOM_CONFIG=y
BR2_LINUX_KERNEL_CUSTOM_CONFIG_FILE="$(EXTERNAL_VENDOR)/board/$(OPENIPC_SOC_FAMILY)/infinity6e-ssc012b.config"
BR2_LINUX_KERNEL_UIMAGE=y
BR2_LINUX_KERNEL_XZ=y

# Filesystem
BR2_PACKAGE_BUSYBOX_CONFIG="$(BR2_EXTERNAL)/package/busybox/busybox.config"
BR2_PACKAGE_EXFATPROGS=y
BR2_PACKAGE_UBOOT_TOOLS=y
BR2_PACKAGE_WIREGUARD_LINUX_COMPAT=y
BR2_PACKAGE_WIREGUARD_TOOLS=y
BR2_PACKAGE_ZLIB=y
# BR2_PACKAGE_IFUPDOWN_SCRIPTS is not set
BR2_TARGET_ROOTFS_CPIO=y
BR2_TARGET_ROOTFS_SQUASHFS=y
BR2_TARGET_ROOTFS_SQUASHFS4_XZ=y
BR2_ROOTFS_POST_IMAGE_SCRIPT="$(EXTERNAL_VENDOR)/board/$(OPENIPC_SOC_FAMILY)/ssc30kq-post-image.sh"

# OpenIPC
BR2_OPENIPC_SOC_VENDOR="sigmastar"
BR2_OPENIPC_SOC_MODEL="ssc30kq"
BR2_OPENIPC_SOC_FAMILY="infinity6e"
BR2_OPENIPC_VARIANT="raptor"
BR2_OPENIPC_FLASH_SIZE="16"
# The rootfs partition, stated because it does not follow from the chip size.
# U-Boot picks between two layouts at boot -- it reads the squashfs superblock at
# 0x250000 and takes 8192k once bytes_used + 0x1000 reaches 0x500000, 5120k
# otherwise (common/cmd_sf.c) -- so the partition table is a function of the
# image being flashed and the build has to be told which of the two it is
# building for. The larger one gives:
#
#   0x000000040000-0x000000050000 : "env"
#   0x000000050000-0x000000250000 : "kernel"       2048KB
#   0x000000250000-0x000000a50000 : "rootfs"       8192KB
#   0x000000a50000-0x000001000000 : "rootfs_data"  5824KB
#
# This was "5120", which is the layout the board runs until the bootloader below
# is written to it, and the numbers above are not what /proc/mtd reports on a
# board that has not had it. THE TWO SETTINGS GO TOGETHER: flashing a >5120KB
# rootfs to a board still running its old U-Boot leaves rootmtd at the
# compiled-in 5120k, and the rootfs then runs 3MB into rootfs_data -- not a
# brick, but every setting on the camera is gone with nothing saying why. Use
# `make fullimage`, which writes both and refuses the combination that does not
# fit.
#
# Do not raise it past 8192 to use the remaining slack. 8192 is what U-Boot's
# larger branch hands out, and nothing here can widen it.
BR2_OPENIPC_ROOTFS_PART_KB="8192"

# Packages
#
# Raptor owns the camera on this image: there is no Majestic and no Divinus, so
# the OSDRV package installs the full Infinity6E vendor library bundle on its
# own (see its BR2_PACKAGE_MAJESTIC condition) and the HAL dlopens what it needs
# from there.
#
# Raptor is fetched from pinned commits on github.com/johnchia (the sigmastar
# branches are not upstream yet), so this target builds with no checkout. To
# build one instead:
#
#   make BOARD=ssc30kq_raptor RAPTOR_SRCDIR=/path/to/raptor-parent
#
# THE SHIPPED raptor.conf CARRIES NO BOARD SETTINGS
#
# Raptor used to carry a raptor-ssc30kq.conf and the package preferred it over
# the generic file. That fork is gone: every image now installs raptor.conf, and
# general/overlay/etc/raptor.conf is what an image changes, which is global
# rather than per-board.
#
# The IR-cut GPIOs went with it. Those were never an SSC30KQ property in the
# first place -- they are board wiring, and two cameras on this part from
# different vendors have no reason to agree -- so a defconfig, which is keyed on
# the SoC model, is the wrong place to state them and this one does not.
# Nothing rediscovers them either: /etc/thingino.json is a thingino file and
# does not exist here, so unset pins mean a filter that never moves.
#
# Set them per camera in the overlay before trusting day/night. raptor's
# docs/sigmastar.md has the pins the bring-up unit used as a worked example,
# plus the H-bridge polarity trap and the night_gain reasoning.
#
# libschrift (rod's glyph rasteriser) and majestic-fonts (the TrueType file it
# loads) are pulled in by the Raptor package rather than listed here.
BR2_PACKAGE_DROPBEAR_OPENIPC=y
BR2_PACKAGE_EXFAT_OPENIPC=y
BR2_PACKAGE_IPCTOOL=y
BR2_PACKAGE_JSONFILTER=y
BR2_PACKAGE_LIBCURL_OPENIPC=y
BR2_PACKAGE_LIBCURL_OPENIPC_CURL=y
# BR2_PACKAGE_LIBCURL_OPENIPC_PROXY_SUPPORT is not set
# BR2_PACKAGE_LIBCURL_OPENIPC_COOKIES_SUPPORT is not set
# BR2_PACKAGE_LIBCURL_OPENIPC_EXTRA_PROTOCOLS_FEATURES is not set
BR2_PACKAGE_MBEDTLS_OPENIPC=y
# The client library only. rmq links libmosquitto, so the Raptor package depends
# on mosquitto unconditionally and it is built for this target whether or not it
# is selected here; selecting it is what makes the broker's `default y` visible
# so it can be turned off. Left implicit, the broker is excluded only because the
# symbol above happens to be unset, which is not a decision anyone made.
BR2_PACKAGE_MOSQUITTO=y
# BR2_PACKAGE_MOSQUITTO_BROKER is not set
BR2_PACKAGE_RAPTOR_STREAMING=y
BR2_PACKAGE_SIGMASTAR_OSDRV_INFINITY6E=y
# The bootloader, built here rather than downloaded, because the two-layout
# rootfs rule above lives in this fork's common/cmd_sf.c and a board running
# anything else keeps rootmtd at 5120k. That is the reason on this target --
# NOT the MAC derivation ssc377qe_raptor wants it for, which reads the NOR
# part's unique ID only on infinity6c. Infinity6E has working die-ID registers
# and already gets a per-unit address, so here this builds a bootloader
# otherwise equivalent to upstream's.
#
# infinity6e_defconfig exists in the tree and takes the same NOR branch of
# sstar-common.h as infinity6c -- same 0x250000 rootfs, same ${rootmtd} in
# bootargs -- so the rule applies unchanged. It is not in the sysupgrade
# tarball: it lands in images/ as u-boot-ssc30kq-nor.bin for `make fullimage`,
# because mtd0 has no software recovery and writing it is a deliberate act.
BR2_PACKAGE_SIGMASTAR_UBOOT=y
BR2_PACKAGE_VTUND_OPENIPC=y
